{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/kitap/:slug/:bolum", "destination": "/oku" },
    { "source": "/kitap/:slug", "destination": "/kitap" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
