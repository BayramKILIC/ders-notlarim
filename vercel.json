{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/kitap/:slug/:bolum", "destination": "/oku.html" },
    { "source": "/kitap/:slug", "destination": "/kitap.html" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
